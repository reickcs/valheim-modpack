# Copy this to .env (same folder as docker-compose.yml) and fill in real
# values. .env is gitignored on purpose -- it holds your server's join
# password. Never commit it.

SERVER_NAME=My Valheim Server
WORLD_NAME=Midgard
SERVER_PASS=change-me
# Comma-separated Steam64 IDs, empty = nobody is an in-game admin
ADMINLIST_IDS=
# true = install/run BepInEx + the modpack; false = vanilla server
BEPINEX=true
# IANA timezone for log timestamps, e.g. America/Chicago, Europe/London
TZ=Etc/UTC
