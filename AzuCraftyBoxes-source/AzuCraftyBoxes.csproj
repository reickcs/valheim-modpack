<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>AzuCraftyBoxes</AssemblyName>
    <RootNamespace>AzuCraftyBoxes</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CS8632: vendored ConfigSync.cs uses "?" nullable-annotation syntax under Nullable=disable elsewhere;
         here Nullable IS enabled (upstream's own code uses it throughout), so this shouldn't fire, but
         left harmless if it does. -->
    <NoWarn>CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Default per-container pull-permission config, extracted to
         BepInEx/config/Azumatt.AzuCraftyBoxes.yml on first run if that file
         doesn't exist yet (Plugin.cs's WriteConfigFileFromResource, matched
         by this default RootNamespace-based manifest name:
         "AzuCraftyBoxes.Example.yml"). Was never actually embedded before,
         so this path had never actually been exercised: every existing
         install's .yml either predates this vendoring or was copied in by
         hand. A genuinely fresh BepInEx/config wipe on 2026-09-13 finally
         hit it: the resource lookup threw FileNotFoundException, uncaught,
         mid-Awake, aborting before harmony.PatchAll() ever ran and silently
         disabling the entire mod on any truly first-time install (including
         via the windows installer, which never bundled a default .yml
         either). -->
    <EmbeddedResource Include="Example.yml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Publicized: see ../ConfigurationManager-source/libs for how these were produced. -->
    <Reference Include="assembly_valheim">
      <HintPath>libs/assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>libs/assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>libs/assembly_guiutils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Splatform">
      <HintPath>libs/Splatform.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>libs/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>libs/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>libs/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
